# Copy this file to .env and fill in your API keys.

# Required for -provider claude (default)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required for -provider openai
OPENAI_API_KEY=sk-your-openai-key-here

# ── Gmail integration (cmd/gmail_sync) ───────────────────────────────────────
# Point this at your downloaded OAuth2 credentials JSON.
# The filename can be the long one Google gives you, or rename it to something shorter.
GMAIL_CREDENTIALS_FILE=gmial-client_secret_550546757593-tev1n78op47laivqj4rvciqaepakgt8e.apps.googleusercontent.com.json

# Where to store the OAuth2 token after the first browser consent.
# This file is auto-created on first run and reused / refreshed automatically.
GMAIL_TOKEN_FILE=gmail_token.json

# ── Outlook integration (cmd/outlook_sync) ───────────────────────────────────
# Application (client) ID from your Azure App Registration.
# See plan.md Part 1 for step-by-step instructions to get this from portal.azure.com.
OUTLOOK_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Where to store the OAuth2 token after the first browser consent.
# This file is auto-created on first run and reused / refreshed automatically.
OUTLOOK_TOKEN_FILE=outlook_token.json

# ── Outlook app-only (non-interactive) auth ───────────────────────────────────
# Requires a Microsoft 365 work/school account — personal @outlook.com accounts
# are not supported by Microsoft for client credentials flow.
#
# Directory (tenant) ID from the Azure App Registration Overview page.
OUTLOOK_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client secret VALUE from Certificates & secrets (shown only once — copy immediately).
OUTLOOK_CLIENT_SECRET=your-client-secret-value-here

# Email address of the mailbox to read (must have Mail.Read Application permission granted).
OUTLOOK_MAILBOX=remittance@yourcompany.com
