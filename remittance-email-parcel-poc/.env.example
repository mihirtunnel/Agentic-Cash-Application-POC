# Copy this file to .env and fill in your API keys.

# Required for -provider claude (default)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required for -provider openai
OPENAI_API_KEY=sk-your-openai-key-here

# ── Gmail integration (cmd/gmail_sync) ───────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → Enable "Gmail API"
# 3. APIs & Services → Credentials → Create OAuth 2.0 Client ID (Desktop app)
# 4. Download the JSON and save it as gmail_credentials.json in the project root
# 5. Run: go run ./cmd/gmail_sync  (browser will open for one-time consent)
#    The token is saved to gmail_token.json automatically for subsequent runs.
#
# GMAIL_CREDENTIALS_FILE=gmail_credentials.json
# GMAIL_TOKEN_FILE=gmail_token.json
